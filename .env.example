# Exemple de fichier .env pour SecureVault
# Ce fichier montre les variables d'environnement attendues
# NE PAS mettre de vraies valeurs ici !

# Base de données
DATABASE_URL=postgres://user:password@localhost:5432/mydb

# API Keys
API_KEY=your_api_key_here
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxx

# Configuration
DEBUG=true
LOG_LEVEL=info
PORT=3000

# Services externes
REDIS_URL=redis://localhost:6379
SMTP_HOST=smtp.example.com
SMTP_USER=user@example.com
SMTP_PASSWORD=your_smtp_password

# Secrets
JWT_SECRET=your_jwt_secret_here
SESSION_SECRET=your_session_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# Pour utiliser avec SecureVault :
# 1. Copiez ce fichier : cp .env.example .env
# 2. Remplissez les vraies valeurs dans .env
# 3. Migrez vers le vault : ./migrate-from-dotenv.sh
# 4. Supprimez .env : rm .env
# 5. Utilisez : vault exec -- votre-commande
